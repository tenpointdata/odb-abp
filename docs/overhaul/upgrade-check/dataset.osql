CREATE CLASS Person EXTENDS V;
CREATE PROPERTY Person.uid LONG;
CREATE PROPERTY Person.name STRING;
CREATE PROPERTY Person.bio STRING;
CREATE PROPERTY Person.born DATETIME;
CREATE PROPERTY Person.tags EMBEDDEDLIST STRING;
CREATE INDEX Person.uid UNIQUE;
CREATE INDEX Person.name NOTUNIQUE;
CREATE INDEX Person.born ON Person (born) NOTUNIQUE_HASH_INDEX;
CREATE INDEX Person.bio ON Person (bio) FULLTEXT ENGINE LUCENE;
CREATE CLASS Knows EXTENDS E;
CREATE PROPERTY Knows.since INTEGER;
CREATE SEQUENCE pid TYPE ORDERED;
CREATE FUNCTION twice "select :a * 2 as r" PARAMETERS [a] LANGUAGE SQL;
